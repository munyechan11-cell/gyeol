{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run clean && vite build && npx esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external",
    "build:static": "npm run clean && vite build",
    "build:server": "npx rimraf dist/server.mjs && npx esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --packages=external",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "npx rimraf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:doctor": "node scripts/db-doctor.mjs",
    "site:dev": "npm --prefix apps/site run dev",
    "site:build": "npm --prefix apps/site run build",
    "site:verify": "node apps/site/scripts/verify-ssr.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "firebase-tools": "^15.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}

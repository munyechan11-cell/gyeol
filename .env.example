# ===== 데이터베이스 (Supabase) =====
# 없으면 서버가 모든 DB 라우트에 503 을 돌려준다 — 조용히 빈 결과를 주지 않는다.
SUPABASE_URL=
# ⚠️ 비밀 키. RLS 를 우회한다. 서버에만 두고, 절대 VITE_ 로 노출하지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Firebase — 이제 FCM 푸시에만 쓴다 =====
# 데이터는 Supabase 로 옮겼다. 아래 값은 알림 발송에만 필요하다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Kakao OAuth
KAKAO_CLIENT_ID=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google — 선택. 넣으면 구글 액세스 토큰의 aud 까지 확인해
# 다른 앱에 발급된 토큰을 가져다 쓰는 것을 막는다.
GOOGLE_CLIENT_ID=

# ===== 프런트엔드 (Supabase) =====
# 여기 키는 **공개용**이다. 번들에 들어가는 게 정상이고, 이 키로 할 수 있는 일은
# RLS 가 허용하는 범위뿐이다. service_role 키를 여기 넣으면 전부에게 공개된다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 문자 발송(Send SMS Hook)이 준비된 뒤에만 "true".
# 그 전에 켜면 모든 사용자가 오지 않을 인증번호를 요구받는다.
VITE_PHONE_OTP_ENABLED=

# ===== 프런트엔드 Firebase — 웹 푸시(FCM)에만 =====
VITE_FCM_VAPID_KEY=
VITE_FIREBASE_API_KEY="your_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"

# Gemini API
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Base URL (used for OAuth redirect URIs)
# Local: http://localhost:3000  | Production: https://your-domain.com
APP_URL=

# Toss Payments (Server-side payment confirmation)
TOSS_SECRET_KEY=

# 토스플레이스 Open API (POS 매출 자동 동기화)
# developers.tossplace.com 앱(gyeol-store) > 인증 정보 = Access/Secret Key, 웹훅 = Secret Key.
# 토스페이먼츠 sk_ 키와 다름. 웹훅이 배포 서버로 오므로 Render 환경변수에도 동일하게 넣어야 함.
TOSSPLACE_ACCESS_KEY=
TOSSPLACE_SECRET_KEY=
TOSSPLACE_WEBHOOK_SECRET=
# API base — 보통 기본값 사용. 개발자 문서에서 실제 주소 확인 권장.
TOSSPLACE_API_BASE=https://open-api.tossplace.com

# Foodtech POS Relay
FOODTECH_API_KEY=
FOODTECH_API_URL=https://api.foodtech.co.kr/v1/order/relay
